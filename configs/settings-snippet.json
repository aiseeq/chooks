{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Agent|Monitor",
        "hooks": [{ "type": "command", "command": "$HOME/bin/chooks pre-tool-use", "timeout": 3 }]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "command": "$HOME/bin/chooks no-prompt", "timeout": 5 }]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/bin/chooks no-prompt", "timeout": 5 }]
      }
    ],
    "Elicitation": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/bin/chooks no-prompt", "timeout": 5 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [{ "type": "command", "command": "$HOME/bin/chooks webfetch-fallback", "timeout": 60 }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/bin/chooks user-prompt-submit", "timeout": 3 }]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/bin/chooks post-tool-batch", "timeout": 3 }]
      }
    ],
    "Notification": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/bin/chooks notification", "timeout": 3 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/bin/chooks stop", "timeout": 3 }]
      }
    ],
    "StopFailure": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/bin/chooks stop-failure", "timeout": 3 }]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/bin/chooks statusline",
    "padding": 0
  }
}
