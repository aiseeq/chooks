# Демон хуков chooks: исполняет вызовы прокси chooks-hook (chooks serve).
# Сокет — от chooks.socket (LISTEN_FDS). Демон выходит сам с кодом 0 после
# замены своего исполняемого файла (graft install), новый поднимает сокет на
# первом соединении из очереди: без паузы RestartSec, которая длиннее окна
# «принято» прокси (100 мс). Падение (код не 0) — перезапуск через 200 мс.
# Лимит запусков — 30 за минуту: два install подряд и падения укладываются,
# а цикл падений останавливается, и хуки идут в CLI (счёт и уведомление —
# на стороне CLI)
[Unit]
Description=chooks hooks daemon
Requires=chooks.socket
After=chooks.socket
StartLimitIntervalSec=60
StartLimitBurst=30

[Service]
Type=simple
ExecStart=%h/bin/chooks serve
Restart=on-failure
RestartSec=200ms
# Выход демона гасит только его: фоновые процессы хуков (ротация учёток из
# строки статуса, наблюдатели уведомлений deliver-alert) идут своей сессией
# и должны его пережить. Судьи и прочие дети запроса умирают с запросом:
# демон выходит, только дообслужив запросы, а отмена запроса убивает их
KillMode=process
